{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FoundryUI",
  "version": "0.1.1-alpha",
  "identifier": "dev.angelobelchior.foundryui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FoundryUI",
        "width": 1280,
        "height": 820,
        "maximized": false,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "trafficLightPosition": { "x": 20, "y": 20 },
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "resources": {
      "localization/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "localization/pt-BR.lproj/InfoPlist.strings": "pt-BR.lproj/InfoPlist.strings",
      "localization/es.lproj/InfoPlist.strings": "es.lproj/InfoPlist.strings"
    },
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
